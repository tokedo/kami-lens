{
  "name": "kami-lens",
  "version": "0.3.0",
  "description": "Read-only local mirror and query surface for the Kamigotchi world \u2014 a headless port of the official client's perception layer.",
  "author": "Anatoly Zaytsev (tokedo)",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs/string-classification.json",
    "LICENSE",
    "README.md",
    "UPSTREAM"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.0",
    "@improbable-eng/grpc-web": "^0.15.0",
    "@stdlib/stats-base-dists-normal-cdf": "^0.3.1",
    "debug": "^4.3.4",
    "ethers": "^6.15.0",
    "lodash-es": "^4.17.21",
    "long": "^5.3.2",
    "mobx": "^6.7.0",
    "moment": "^2.30.1",
    "nice-grpc-common": "^2.0.2",
    "nice-grpc-web": "^2.0.1",
    "pluralize": "^8.0.0",
    "protobufjs": "^6.11.6",
    "rxjs": "^7.5.5",
    "smol-toml": "^1.7.0",
    "type-fest": "^2.14.0",
    "viem": "^2.55.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/debug": "^4.1.12",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.0.0",
    "@types/pluralize": "^0.0.33",
    "ajv": "^8.20.0",
    "eslint": "^9.0.0",
    "react": "^19.2.7",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite-tsconfig-paths": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "bin": {
    "kami-lens": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tokedo/kami-lens.git"
  }
}
