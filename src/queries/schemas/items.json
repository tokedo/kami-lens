{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kami-lens/schemas/items.json",
  "$ref": "#/$defs/Items",
  "$defs": {
    "Items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "pools"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Item"
          }
        },
        "pools": {
          "type": "array",
          "description": "every swap venue the mirror knows; an empty array is a legal answer",
          "items": {
            "$ref": "#/$defs/Pool"
          }
        }
      }
    },
    "Item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index",
        "name",
        "type",
        "description",
        "for",
        "rarity"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "index": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "for": {
          "type": "string"
        },
        "rarity": {
          "type": "number"
        },
        "pools": {
          "type": "array",
          "description": "swap venues trading this item; an empty array means none",
          "items": {
            "$ref": "#/$defs/Pool"
          }
        }
      }
    },
    "Pool": {
      "type": "object",
      "additionalProperties": false,
      "description": "A constant-product swap venue between two items. Facts only: reserves, fee, share supply, creation time. No swap quote is served \u2014 see impliedRate.",
      "required": [
        "id",
        "items",
        "reserves",
        "feeBps",
        "lpSupply",
        "startTime"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "description": "the traded pair, item registry indices, low index first",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "reserves": {
          "type": "array",
          "description": "reserve held of each item, positionally aligned to items",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "feeBps": {
          "type": "number",
          "description": "swap fee in basis points; 10000 = 100%"
        },
        "lpSupply": {
          "type": "number"
        },
        "startTime": {
          "type": "number"
        },
        "disabled": {
          "type": "boolean"
        },
        "impliedRate": {
          "type": "object",
          "description": "PURE RESERVE RATIO \u2014 fee-exclusive and impact-exclusive. A valuation of current depth, NOT a swap quote: a real swap moves along the curve and pays feeBps. Omitted when either reserve is zero.",
          "additionalProperties": false,
          "required": [
            "item0PerItem1",
            "item1PerItem0"
          ],
          "properties": {
            "item0PerItem1": {
              "type": "number"
            },
            "item1PerItem0": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
