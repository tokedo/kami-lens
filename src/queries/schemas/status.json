{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kami-lens/schemas/status.json",
  "$ref": "#/$defs/Status",
  "$defs": {
    "Status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "liveBlockNumber",
        "startedAt",
        "tripwires",
        "degraded",
        "kamiden",
        "clockOffsetMs",
        "config"
      ],
      "properties": {
        "state": {
          "type": "string"
        },
        "msg": {
          "type": "string"
        },
        "percentage": {
          "type": "number"
        },
        "liveBlockNumber": {
          "type": "number"
        },
        "blockLag": {
          "type": "number"
        },
        "startedAt": {
          "type": "string"
        },
        "liveAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkpoint": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "tripwires": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "degraded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kamiden": {
          "$ref": "#/$defs/KamidenStatus"
        },
        "clockOffsetMs": {
          "type": "number"
        },
        "clockLastSyncWallMs": {
          "type": "number"
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chainId",
            "worldAddress",
            "jsonRpcUrl",
            "dataDir"
          ],
          "properties": {
            "chainId": {
              "type": "number"
            },
            "worldAddress": {
              "type": "string"
            },
            "jsonRpcUrl": {
              "type": "string"
            },
            "wsRpcUrl": {
              "type": "string"
            },
            "kamigazeUrl": {
              "type": "string"
            },
            "kamidenUrl": {
              "type": "string"
            },
            "chatEnabled": {
              "type": "boolean"
            },
            "dataDir": {
              "type": "string"
            },
            "checkpointIntervalMs": {
              "type": "number"
            }
          }
        },
        "streamSilentMs": {
          "type": "number"
        }
      }
    },
    "KamidenStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configured", "url", "stream", "buffer", "unary"],
      "properties": {
        "configured": { "type": "boolean" },
        "url": { "type": ["string", "null"] },
        "stream": { "$ref": "#/$defs/KamidenStream" },
        "buffer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size", "capacity", "evicted", "newestSeq"],
          "properties": {
            "size": { "type": "number" },
            "capacity": { "type": "number" },
            "evicted": { "type": "number" },
            "newestSeq": { "type": "number" }
          }
        },
        "unary": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "KamidenStream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "topics",
        "startedAt",
        "framesReceived",
        "feedFrames",
        "lastFrameAtWallMs",
        "silentMs",
        "messageFramesDropped",
        "messagesDropped",
        "retries",
        "consecutiveFailures",
        "lastError",
        "events"
      ],
      "properties": {
        "state": { "type": "string" },
        "topics": { "type": "array", "items": { "type": "string" } },
        "startedAt": { "type": ["string", "null"] },
        "framesReceived": { "type": "number" },
        "feedFrames": { "type": "number" },
        "lastFrameAtWallMs": { "type": "number" },
        "silentMs": { "type": "number" },
        "messageFramesDropped": { "type": "number" },
        "messagesDropped": { "type": "number" },
        "retries": { "type": "number" },
        "consecutiveFailures": { "type": "number" },
        "lastError": { "type": ["string", "null"] },
        "events": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    }
  }
}