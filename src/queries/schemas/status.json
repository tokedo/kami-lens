{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kami-lens/schemas/status.json",
  "$ref": "#/$defs/Status",
  "$defs": {
    "Status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "upstreamPin",
        "state",
        "liveBlockNumber",
        "startedAt",
        "tripwires",
        "degraded",
        "feedsDegraded",
        "kamiden",
        "clockOffsetMs",
        "config",
        "configSources",
        "rpcReads"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "upstreamPin": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "msg": {
          "type": "string"
        },
        "percentage": {
          "type": "number"
        },
        "liveBlockNumber": {
          "type": "number"
        },
        "blockLag": {
          "type": "number",
          "description": "§3.15 (0.5.1): chain head minus the mirror's last-applied block (`liveBlockNumber`), from one eth_blockNumber taken at status time. Declared since 0.5.0 and never populated until now. ABSENT — together with headBlockNumber and headSampledAt — when the RPC read fails: never 0, never null (§3.14). A nonzero lag is the NORMAL resting state of a healthy mirror, because liveBlockNumber does not advance on a block that produced no world events; it is information, not a fault, and `meta.stale` is NOT derived from it."
        },
        "startedAt": {
          "type": "string"
        },
        "liveAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkpoint": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "tripwires": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "degraded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "feedsDegraded": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "§1.2 (0.5.2): Kamiden FEED health, shaped like `degraded` so a caller gates on it the same way, and kept separate from it because `degraded` is chain-only and drives meta.stale (§3.2). 'kamiden-stream:<state>' whenever the stream is not live; 'kamiden-silent:<N>s' past SILENT_STALL_MS. Empty array when healthy — never absent."
        },
        "kamiden": {
          "$ref": "#/$defs/KamidenStatus"
        },
        "clockOffsetMs": {
          "type": "number"
        },
        "clockLastSyncWallMs": {
          "type": "number"
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chainId",
            "worldAddress",
            "jsonRpcUrl",
            "dataDir"
          ],
          "properties": {
            "chainId": {
              "type": "number"
            },
            "worldAddress": {
              "type": "string"
            },
            "jsonRpcUrl": {
              "type": "string"
            },
            "wsRpcUrl": {
              "type": "string"
            },
            "kamigazeUrl": {
              "type": "string"
            },
            "kamidenUrl": {
              "type": "string"
            },
            "chatEnabled": {
              "type": "boolean"
            },
            "enrich": {
              "type": "boolean",
              "description": "§3.12 payload enrichment. Always present, so the switch is visible whether it is on or off — the one key by which a flag-off 0.4.0 answer differs from 0.3.0 (G3.g)."
            },
            "defaultOperator": {
              "type": "number"
            },
            "dataDir": {
              "type": "string"
            },
            "checkpointIntervalMs": {
              "type": "number"
            }
          }
        },
        "configSources": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "configFile": {
          "type": [
            "string",
            "null"
          ]
        },
        "streamSilentMs": {
          "type": "number"
        },
        "bootstrapMode": {
          "type": "string"
        },
        "resumeFromBlock": {
          "type": "number"
        },
        "rpcReads": {
          "type": "object",
          "additionalProperties": false,
          "description": "§3.13 (0.5.0): health of the ONE chain read the query layer makes (the account gas balance). Reported here for exactly the reason the per-feed Kamiden block is: the answer that needed it simply OMITS the block, so a reader must be able to tell \"this account holds nothing\" from \"the read did not happen\".",
          "required": [
            "ok",
            "failed"
          ],
          "properties": {
            "ok": {
              "type": "number"
            },
            "failed": {
              "type": "number"
            },
            "lastError": {
              "type": "string",
              "description": "Present only when a read has failed: an omitted key means none has."
            }
          }
        },
        "headBlockNumber": {
          "type": "number",
          "description": "§3.15 (0.5.1): the chain head this lag was computed against. Served beside the lag so the subtraction is auditable rather than asserted."
        },
        "headSampledAt": {
          "type": "string",
          "description": "§3.15 (0.5.1): when the head read landed (§3.8 clock). A head number of unknown age is not evidence."
        }
      }
    },
    "KamidenStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configured",
        "url",
        "stream",
        "buffer",
        "unary"
      ],
      "properties": {
        "configured": {
          "type": "boolean"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "stream": {
          "$ref": "#/$defs/KamidenStream"
        },
        "buffer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "capacity",
            "evicted",
            "newestSeq"
          ],
          "properties": {
            "size": {
              "type": "number"
            },
            "capacity": {
              "type": "number"
            },
            "evicted": {
              "type": "number"
            },
            "newestSeq": {
              "type": "number"
            }
          }
        },
        "unary": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "KamidenStream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "topics",
        "startedAt",
        "framesReceived",
        "feedFrames",
        "lastFrameAtWallMs",
        "silentMs",
        "messageFramesDropped",
        "messagesDropped",
        "retries",
        "consecutiveFailures",
        "lastError",
        "events"
      ],
      "properties": {
        "state": {
          "type": "string"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "startedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "framesReceived": {
          "type": "number"
        },
        "feedFrames": {
          "type": "number"
        },
        "lastFrameAtWallMs": {
          "type": "number"
        },
        "silentMs": {
          "type": "number"
        },
        "messageFramesDropped": {
          "type": "number"
        },
        "messagesDropped": {
          "type": "number"
        },
        "retries": {
          "type": "number"
        },
        "consecutiveFailures": {
          "type": "number"
        },
        "lastError": {
          "type": [
            "string",
            "null"
          ]
        },
        "events": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    }
  }
}
