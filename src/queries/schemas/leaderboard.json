{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kami-lens/schemas/leaderboard.json",
  "$ref": "#/$defs/Leaderboard",
  "$defs": {
    "Leaderboard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "epoch",
        "itemIndex",
        "rows",
        "rowsTotal",
        "rowsServed"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "epoch": {
          "type": "number"
        },
        "itemIndex": {
          "type": "number"
        },
        "rowsTotal": {
          "type": "number",
          "description": "§3.13: every ranked row, whether or not this answer served it. 1,475 measured at one pin, a 175 KB answer."
        },
        "rowsServed": {
          "type": "number",
          "description": "§3.13: how many rows this answer carries. Already value-sorted, so the cap is the top N; --full lifts it."
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScoreRow"
          }
        }
      }
    },
    "ScoreRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "account",
        "value"
      ],
      "properties": {
        "rank": {
          "type": "number"
        },
        "account": {
          "$ref": "#/$defs/AccountIdRef"
        },
        "value": {
          "type": "number"
        }
      }
    },
    "AccountIdRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "id": {
          "type": "string",
          "description": "The raw holder id — a 66-character hex string on every row. Served under `--full`, and on any row whose holder is not an account (§3.13): the account INDEX is what a consumer joins on."
        },
        "index": {
          "type": "number"
        },
        "name": {
          "type": "string"
        }
      }
    }
  }
}
