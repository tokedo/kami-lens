{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kami-lens/schemas/account.json",
  "$ref": "#/$defs/Account",
  "$defs": {
    "Account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index",
        "name",
        "ownerAddress",
        "operatorAddress",
        "roomIndex",
        "musu",
        "stamina",
        "reputation",
        "kamis"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "index": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "ownerAddress": {
          "type": "string"
        },
        "operatorAddress": {
          "type": "string"
        },
        "roomIndex": {
          "type": "number"
        },
        "musu": {
          "type": "number"
        },
        "stamina": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current",
            "total"
          ],
          "properties": {
            "current": {
              "type": "number"
            },
            "total": {
              "type": "number"
            }
          }
        },
        "reputation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agency",
            "mina",
            "nursery"
          ],
          "properties": {
            "agency": {
              "type": "number"
            },
            "mina": {
              "type": "number"
            },
            "nursery": {
              "type": "number"
            }
          }
        },
        "kamis": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KamiRef"
          }
        },
        "bio": {
          "type": "string"
        },
        "room": {
          "$ref": "#/$defs/RoomRef",
          "description": "§3.12 (enrich): roomIndex resolved. On roster, {index, name} only — the compact answer stays compact."
        }
      }
    },
    "KamiRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "index": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      }
    },
    "RoomRef": {
      "type": "object",
      "additionalProperties": false,
      "description": "§3.12 (enrich): a room index resolved to its registry name and description. Present only when the daemon runs with enrich=true. An index the mirror has no room for keeps the index and answers with empty strings.",
      "required": ["index", "name"],
      "properties": {
        "index": { "type": "number" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    }
  }
}
