{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kami-lens/schemas/auctions.json",
  "$ref": "#/$defs/Auctions",
  "$defs": {
    "Auctions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auctions"],
      "properties": {
        "auctions": { "type": "array", "items": { "$ref": "#/$defs/Auction" } },
        "buys": { "type": "array", "items": { "$ref": "#/$defs/AuctionBuy" } }
      }
    },
    "Auction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["params", "supply", "startTime", "price"],
      "properties": {
        "auctionItem": { "$ref": "#/$defs/ItemRef" },
        "paymentItem": { "$ref": "#/$defs/ItemRef" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "period", "decay", "rate"],
          "properties": {
            "value": { "type": "number" },
            "period": { "type": "number" },
            "decay": { "type": "number" },
            "rate": { "type": "number" }
          }
        },
        "supply": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sold", "total"],
          "properties": {
            "sold": { "type": "number" },
            "total": { "type": "number" }
          }
        },
        "startTime": { "type": "number" },
        "price": {
          "type": ["number", "null"],
          "description": "The price of ONE unit now, on the ported GDA curve. 1.1.0 (§3.19): null exactly when the chain would refuse the buy — priceUnavailable says why. Until 1.1.0 a cost that had decayed to zero was served as 1."
        },
        "priceUnavailable": {
          "type": "string",
          "enum": ["COST_ROUNDS_TO_ZERO", "BEYOND_FIXED_POINT_RANGE"],
          "description": "1.1.0 (§3.19): present exactly when price is null. COST_ROUNDS_TO_ZERO: the chain reverts the buy, the decayed cost rounds to zero in its fixed point (LibAuction.calcBuy: \"negative GDA cost\"). BEYOND_FIXED_POINT_RANGE: the chain reverts, the price exceeds its fixed-point range (PRBMath exp2)."
        }
      }
    },
    "AuctionBuy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountIndex", "itemIndex", "amount", "currency", "cost", "timestamp"],
      "properties": {
        "accountIndex": { "type": "string" },
        "itemIndex": { "type": "number" },
        "amount": { "type": "number" },
        "currency": { "type": "number" },
        "cost": { "type": "number" },
        "timestamp": { "type": "number" }
      }
    },
    "ItemRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "name"],
      "properties": {
        "index": { "type": "number" },
        "name": { "type": "string" },
        "description": {
          "type": "string",
          "description": "\u00a73.12 (enrich): the item's registry description. Present only when the daemon runs with enrich=true AND this ref is on a decision surface (open trades and offers, auction lots, merchant payment currency) \u2014 history rows keep the bare name."
        }
      }
    }
  }
}
