{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kami-lens/schemas/party.json",
  "$ref": "#/$defs/Party",
  "$defs": {
    "Party": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account",
        "kamisTotal",
        "kamisServed",
        "kamis"
      ],
      "properties": {
        "account": {
          "$ref": "#/$defs/AccountRef"
        },
        "kamisTotal": {
          "type": "number",
          "description": "§3.13: every kami the account owns, whether or not this answer served it."
        },
        "kamisServed": {
          "type": "number",
          "description": "§3.13: how many rows this answer carries. Below the total when the cap fired; --full lifts it."
        },
        "kamis": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KamiVitals"
          }
        }
      }
    },
    "KamiVitals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index",
        "name",
        "state",
        "hp",
        "hpRatePerHr",
        "cooldownSec"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "index": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "level": {
          "type": "number"
        },
        "hp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current",
            "total",
            "percent"
          ],
          "properties": {
            "current": {
              "type": "number"
            },
            "total": {
              "type": "number"
            },
            "percent": {
              "type": "number"
            }
          }
        },
        "hpRatePerHr": {
          "type": "string"
        },
        "musu": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accrued",
            "spotRatePerHr",
            "avgRatePerHr"
          ],
          "properties": {
            "accrued": {
              "type": "number"
            },
            "spotRatePerHr": {
              "type": "string"
            },
            "avgRatePerHr": {
              "type": "string"
            }
          }
        },
        "cooldownSec": {
          "type": "number"
        },
        "node": {
          "$ref": "#/$defs/NodeRef"
        },
        "account": {
          "$ref": "#/$defs/AccountRef"
        },
        "xp": {
          "type": "number",
          "description": "§3.13: experience banked toward the next level."
        },
        "xpRequired": {
          "type": "number",
          "description": "§3.13: what the next level costs, on the pinned client's own curve (calcExperienceRequirement)."
        },
        "levelUpReady": {
          "type": "boolean",
          "description": "§3.13: BOTH conditions the chain's KamiLevelSystem requires — enough experience AND resting. The reference client renders this two contradictory ways (SPEC §4.2); the chain's own precondition wins."
        },
        "levelUpBlockedBy": {
          "type": "string",
          "enum": [
            "EXPERIENCE",
            "NOT_RESTING"
          ],
          "description": "§3.13: present exactly when levelUpReady is false, in the reference client's own tooltip precedence (experience first, then resting state)."
        },
        "skillPoints": {
          "type": "number",
          "description": "§3.13: unspent skill points — the reference client's \"SP\" badge."
        }
      }
    },
    "NodeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "name"
      ],
      "properties": {
        "index": {
          "type": "number"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "AccountRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "name"
      ],
      "properties": {
        "index": {
          "type": "number"
        },
        "name": {
          "type": "string"
        }
      }
    }
  }
}
