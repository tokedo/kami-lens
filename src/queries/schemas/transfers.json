{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kami-lens/schemas/transfers.json",
  "$ref": "#/$defs/Transfers",
  "$defs": {
    "Transfers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account", "transfers"],
      "properties": {
        "account": { "$ref": "#/$defs/AccountRef" },
        "transfers": { "type": "array", "items": { "$ref": "#/$defs/Transfer" } }
      }
    },
    "Transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sender", "recipient", "item", "amount"],
      "properties": {
        "sender": { "$ref": "#/$defs/AccountIdRef" },
        "recipient": { "$ref": "#/$defs/AccountIdRef" },
        "item": { "$ref": "#/$defs/ItemRef" },
        "amount": { "type": "string" }
      }
    },
    "ItemRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "name"],
      "properties": {
        "index": { "type": "number" },
        "name": { "type": "string" },
        "description": {
          "type": "string",
          "description": "\u00a73.12 (enrich): the item's registry description. Present only when the daemon runs with enrich=true AND this ref is on a decision surface (open trades and offers, auction lots, merchant payment currency) \u2014 history rows keep the bare name."
        }
      }
    },
    "AccountRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "name"],
      "properties": {
        "index": { "type": "number" },
        "name": { "type": "string" }
      }
    },
    "AccountIdRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "index": { "type": "number" },
        "name": { "type": "string" }
      }
    }
  }
}
