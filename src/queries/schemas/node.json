{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kami-lens/schemas/node.json",
  "$ref": "#/$defs/Node",
  "$defs": {
    "Node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "name",
        "type",
        "affinity",
        "roomIndex",
        "harvestsTotal",
        "harvestsServed",
        "harvests"
      ],
      "properties": {
        "index": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "affinity": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "roomIndex": {
          "type": "number"
        },
        "description": {
          "type": "string",
          "description": "`--full` only from 0.5.0 (§3.13)."
        },
        "attacker": {
          "$ref": "#/$defs/Attacker"
        },
        "harvestsTotal": {
          "type": "number",
          "description": "§3.13: every ACTIVE harvest on the node, whether or not this answer served it. 732 measured on one node at one pin, a 266 KB answer with vitals."
        },
        "harvestsServed": {
          "type": "number",
          "description": "§3.13: how many rows this answer carries. Below the total when the cap fired; --full lifts it."
        },
        "harvests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Harvest"
          }
        },
        "room": {
          "$ref": "#/$defs/RoomRef",
          "description": "§3.12 (enrich): roomIndex resolved. On roster, {index, name} only — the compact answer stays compact."
        }
      }
    },
    "Harvest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "kami",
        "account"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "`--full` only from 0.5.0 (§3.13)."
        },
        "state": {
          "type": "string"
        },
        "kami": {
          "$ref": "#/$defs/KamiRef"
        },
        "account": {
          "$ref": "#/$defs/AccountRef"
        },
        "vitals": {
          "$ref": "#/$defs/HarvestVitals"
        },
        "liquidation": {
          "$ref": "#/$defs/Liquidation"
        }
      }
    },
    "HarvestVitals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hp",
        "musuAccrued",
        "cooldownSec"
      ],
      "properties": {
        "hp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current",
            "total",
            "percent"
          ],
          "properties": {
            "current": {
              "type": "number"
            },
            "total": {
              "type": "number"
            },
            "percent": {
              "type": "number"
            }
          }
        },
        "hpRatePerHr": {
          "type": "string",
          "description": "`--full` only from 0.5.0 (§3.13)."
        },
        "musuAccrued": {
          "type": "number"
        },
        "cooldownSec": {
          "type": "number"
        },
        "level": {
          "type": "number",
          "description": "§3.13: the occupant's level. This is the surface a liquidation decision is made on, and it served health without ever naming how strong the thing holding it was."
        },
        "xp": {
          "type": "number",
          "description": "§3.13: the occupant's banked experience."
        },
        "xpRequired": {
          "type": "number",
          "description": "§3.13: what the occupant's next level costs."
        },
        "levelUpReady": {
          "type": "boolean",
          "description": "§3.13: enough experience AND resting."
        },
        "levelUpBlockedBy": {
          "type": "string",
          "enum": [
            "EXPERIENCE",
            "NOT_RESTING"
          ],
          "description": "§3.13: present exactly when levelUpReady is false."
        },
        "skillPoints": {
          "type": "number",
          "description": "§3.13: the occupant's unspent skill points."
        }
      }
    },
    "Liquidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible",
        "threshold",
        "spoils",
        "salvage",
        "recoil"
      ],
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "enum": [
            "ATTACKER_STARVING",
            "ATTACKER_COOLDOWN",
            "TARGET_HP_ABOVE_THRESHOLD",
            "THRESHOLD_ZERO"
          ],
          "description": "§3.13 (0.5.0): present exactly when `eligible` is false. Upstream's own precedence, from the reference client's LiquidateButton tooltip: starving first, then cooldown, then the threshold comparison — with the degenerate no-threshold-at-all case called out separately, exactly as that tooltip does. The client's fifth branch (\"your kamis aren't on this node\") has no analogue here: the attacker is a general argument on this surface, never an own-only path (§3.6)."
        },
        "threshold": {
          "type": "number"
        },
        "spoils": {
          "type": "number"
        },
        "salvage": {
          "type": "number"
        },
        "recoil": {
          "type": "number"
        }
      }
    },
    "Attacker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index",
        "name",
        "cooldownSec"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "index": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "cooldownSec": {
          "type": "number"
        }
      }
    },
    "KamiRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "`--full` only from 0.5.0 on node harvest rows (§3.13)."
        },
        "index": {
          "type": "number"
        },
        "name": {
          "type": "string",
          "description": "`--full` only from 0.5.0 on node harvest rows (§3.13)."
        },
        "state": {
          "type": "string"
        }
      }
    },
    "AccountRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index"
      ],
      "properties": {
        "index": {
          "type": "number"
        },
        "name": {
          "type": "string",
          "description": "`--full` only from 0.5.0 on node harvest rows (§3.13)."
        }
      }
    },
    "RoomRef": {
      "type": "object",
      "additionalProperties": false,
      "description": "§3.12 (enrich): a room index resolved to its registry name and description. Present only when the daemon runs with enrich=true. An index the mirror has no room for keeps the index and answers with empty strings.",
      "required": [
        "index",
        "name"
      ],
      "properties": {
        "index": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
