{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kami-lens/schemas/node.json",
  "$ref": "#/$defs/Node",
  "$defs": {
    "Node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "name",
        "type",
        "affinity",
        "roomIndex",
        "description",
        "harvests"
      ],
      "properties": {
        "index": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "affinity": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "roomIndex": {
          "type": "number"
        },
        "description": {
          "type": "string"
        },
        "attacker": {
          "$ref": "#/$defs/Attacker"
        },
        "harvests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Harvest"
          }
        },
        "room": {
          "$ref": "#/$defs/RoomRef",
          "description": "§3.12 (enrich): roomIndex resolved. On roster, {index, name} only — the compact answer stays compact."
        }
      }
    },
    "Harvest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "kami",
        "account"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "kami": {
          "$ref": "#/$defs/KamiRef"
        },
        "account": {
          "$ref": "#/$defs/AccountRef"
        },
        "vitals": {
          "$ref": "#/$defs/HarvestVitals"
        },
        "liquidation": {
          "$ref": "#/$defs/Liquidation"
        }
      }
    },
    "HarvestVitals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hp",
        "hpRatePerHr",
        "musuAccrued",
        "cooldownSec"
      ],
      "properties": {
        "hp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current",
            "total",
            "percent"
          ],
          "properties": {
            "current": {
              "type": "number"
            },
            "total": {
              "type": "number"
            },
            "percent": {
              "type": "number"
            }
          }
        },
        "hpRatePerHr": {
          "type": "string"
        },
        "musuAccrued": {
          "type": "number"
        },
        "cooldownSec": {
          "type": "number"
        }
      }
    },
    "Liquidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible",
        "threshold",
        "spoils",
        "salvage",
        "recoil"
      ],
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "threshold": {
          "type": "number"
        },
        "spoils": {
          "type": "number"
        },
        "salvage": {
          "type": "number"
        },
        "recoil": {
          "type": "number"
        }
      }
    },
    "Attacker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index",
        "name",
        "cooldownSec"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "index": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "cooldownSec": {
          "type": "number"
        }
      }
    },
    "KamiRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "index": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      }
    },
    "AccountRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "name"
      ],
      "properties": {
        "index": {
          "type": "number"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "RoomRef": {
      "type": "object",
      "additionalProperties": false,
      "description": "§3.12 (enrich): a room index resolved to its registry name and description. Present only when the daemon runs with enrich=true. An index the mirror has no room for keeps the index and answers with empty strings.",
      "required": ["index", "name"],
      "properties": {
        "index": { "type": "number" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    }
  }
}
