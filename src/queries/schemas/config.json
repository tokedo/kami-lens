{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kami-lens/schemas/config.json",
  "$ref": "#/$defs/Config",
  "$defs": {
    "Config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    }
  }
}
