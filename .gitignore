node_modules/
dist/
build/
# runtime data output — anchored to repo root so it can never swallow a
# source directory named data/ or Data/ (see src/network/**/[Dd]ata/).
/data/
!src/**/data/
!src/**/Data/
*.log
.env
.env.*
.DS_Store
gates/.artifacts/
gates/fixtures/g2b-screenshots/
# the hand-captured G2.b / G3.c transcription is a local file, never public
# (1.2.1; gates/g2/observations.mts — or the path G2B_OBSERVATIONS names)
gates/fixtures/g2b-observations.json

# release tarballs are build artifacts, never tracked: two stale ones used to
# ride into the Docker build stage and race the fresh pack (see Dockerfile)
*.tgz
